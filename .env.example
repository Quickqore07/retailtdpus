APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:xxxxxxxxx=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xxxxxxx
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=xxx

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=xxxx@gmail.com
MAIL_PASSWORD="xxxxx"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=xxxx@gmail.com
MAIL_FROM_NAME="xx xx"


PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxx
AWS_DEFAULT_REGION=xxxx
AWS_BUCKET=xxxx
AWS_BACKUP_BUCKET=xxxx
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://xxxx.s3.xxxx.amazonaws.com

# Database backup S3 sync (backup:create, backup:all-databases)
BACKUP_S3_ENABLED=true
BACKUP_S3_PREFIX=backups
BACKUP_S3_KEEP=15
BACKUP_S3_KEEP_DAYS=30

VITE_APP_NAME="${APP_NAME}"
BREVO_API_KEY=xxxxx
BREVO_MAIL_FROM_ADDRESS=xxxx@gmail.com
BREVO_MAIL_FROM_NAME="xx xx"

# QUICKQORE_API_URL="https://go.quickqore.com"
QUICKQORE_API_URL="http://127.0.0.1:9000"

CUSTOM_SECRET_KEY=base64:xxxxx
CUSTOM_CIPHER=xxxx

BREVO_API_KEY=xxxxx
BREVO_MAIL_FROM_ADDRESS=xxxx@gmail.com
BREVO_MAIL_FROM_NAME="xx xx"


I9_WITH_WORK_BRIGHT = false
WORK_BRIGHT_BASE_URL='https://xxxx.com/'
WORK_BRIGHT_APP_URL='https://xxxx.com/'   
WORK_BRIGHT_API_KEY=xxxxx

SKIP_ONBOARDING=false

BACKUP_NOTIFICATION_EMAIL='xxxx@gmail.com'
QUICKQORE_SECURITY_KEY='xxxxx'
