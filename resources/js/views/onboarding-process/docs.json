    "list_c_doc_title": {
        "1": {"key": "1", "value": "1. Social Security Account Number card, unless the card includes one of the following restrictions"},
        "1a": {"key": "1a", "value": "1(a). NOT VALID FOR EMPLOYMENT"},
        "1b": {"key": "1b", "value": "1(b). VALID FOR WORK ONLY WITH INS AUTHORIZATION"},
        "1c": {"key": "1c", "value": "1(c). VALID FOR WORK ONLY WITH DHS AUTHORIZATION"},
        "2": {"key": "2", "value": "2. Certification of report of birth issued by the Department of State (Forms DS-1350, FS-545, FS-240)"},
