        "4": {"key": "4", "value": "4. Native American tribal document"},
        "5": {"key": "5", "value": "5. U.S. Citizen ID Card (Form I-197)"},
        "6": {"key": "6", "value": "6. Identification Card for Use of Resident Citizen in the United States (Form I-179)"},
        "7": {"key": "7", "value": "7. Employment authorization document issued by the Department of Homeland Security"}
    },
