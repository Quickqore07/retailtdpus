    "list_a_doc_title_1": {
        "1": {"key": "1", "value": "1. U.S. Passport or U.S. Passport Card"},
        "2": {"key": "2", "value": "2. Permanent Resident Card or Alien Registration Receipt Card (Form I-551)"},
        "3": {"key": "3", "value": "3. Foreign passport with temporary I-551 stamp or notation on a machine-readable immigrant visa"},
        "4": {"key": "4", "value": "4. Employment Authorization Document (Form I-766) with photograph"},
        "5": {"key": "5", "value": "5. For an individual temporarily authorized to work (specific employer due to status/parole)"},
        "5a": {"key": "5a", "value": "a. Foreign passport"},
        "5b": {"key": "5b", "value": "b. Form I-94 or Form I-94A"},
        "5(1)": {"key": "5(1)", "value": "(1) Same name as passport"},
        "5(2)": {"key": "5(2)", "value": "(2) Endorsement of status/parole (valid, not expired, no conflicts)"},
        "6": {"key": "6", "value": "6. Passport from FSM or RMI with Form I-94 or I-94A indicating nonimmigrant admission"}
    },
    "list_b_doc_title": {
